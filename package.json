{
  "name": "dsh-token-board",
  "version": "0.1.4",
  "type": "module",
  "description": "Token usage dashboard for the DeepSeek Harness Web GUI (dsh web and DSH Desktop): metric cards, a heat calendar over 3/6/12 months or all history, click-through day detail with provider breakdown, provider and model rankings, and a dual-metric trend chart. Reads local session logs only; no network access.",
  "icon": "icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./usage": "./lib/usage.js",
    "./package.json": "./package.json",
    "./ledger": "./lib/ledger-merge.js"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/usage.js",
    "lib/ledger-merge.js",
    "lib/model-names.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "THIRD-PARTY.md",
    "LICENSE",
    "ORIGINALITY.md",
    "scripts/check-client.mjs",
    "scripts/dst.mjs",
    "scripts/offline-backfill.mjs",
    "docs/images/overview.png"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "token-usage",
    "dashboard",
    "deepseek-harness"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HTempt/dsh-token-board.git"
  },
  "homepage": "https://github.com/HTempt/dsh-token-board#readme",
  "bugs": {
    "url": "https://github.com/HTempt/dsh-token-board/issues"
  },
  "author": "HTempt",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
